#!/usr/bin/env bash
set -euo pipefail

ALLOWED_DIRS=()

while [ $# -gt 0 ]; do
  case "$1" in
    -D)
      if [ $# -lt 2 ]; then
        echo "Error: -D requires a directory path" >&2
        exit 1
      fi
      ALLOWED_DIRS+=("$2")
      shift 2
      ;;
    -D*)
      dir="${1#-D}"
      dir="${dir#=}"
      if [ -z "$dir" ]; then
        echo "Error: -D requires a directory path" >&2
        exit 1
      fi
      ALLOWED_DIRS+=("$dir")
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -eq 0 ]; then
  echo "Usage: $0 [-Ddir ...] <command> [args...]" >&2 
  exit 1
fi

PROJECT_DIR="$(pwd -P)"

resolve_path() {
  local target="$1"
  target="${target/#\~/$HOME}"
  if [ ! -d "$target" ]; then
    echo "Error: Directory '$1' does not exist or is not a directory." >&2
    exit 1
  fi
  (cd "$target" && pwd -P)
}

RESOLVED_ALLOWED_DIRS=()
for dir in "${ALLOWED_DIRS[@]}"; do
  RESOLVED_ALLOWED_DIRS+=("$(resolve_path "$dir")")
done

run_darwin() {
  local extra_subpaths=""
  for dir in "${RESOLVED_ALLOWED_DIRS[@]}"; do
    extra_subpaths+=$'\n'"  (subpath \"${dir}\")"
  done

  local seatbelt_profile
  seatbelt_profile=$(cat <<EOF
(version 1)
(allow default)

; Block all file write/modify/delete syscalls system-wide
(deny file-write*)

; Allow writes in safe zone
(allow file-write*
  (subpath "${PROJECT_DIR}")
  (subpath "/private/tmp")
  (subpath "${HOME}/.codex")
  (subpath "${HOME}/.gemini")
  (subpath "${HOME}/.claude")
  (regex #"^/dev/(null|zero|tty)$")
  ${extra_subpaths}
)

; Avoid reading credentials
(deny file-read*
  (subpath "${HOME}/.ssh")
)

; Avoid escalating privileges
(deny process-exec (regex #"(/|^)(sudo|su|login|doas|pkexec)$"))
EOF
)

  exec sandbox-exec -p "$seatbelt_profile" -- "$@"
}

run_linux() {
  if ! command -v bwrap >/dev/null 2>&1; then
    echo "Error: bubblewrap ('bwrap') is required on Linux but not found in PATH." >&2
    exit 1
  fi

  local bwrap_args=(
    --die-with-parent
    --unshare-pid
    --proc /proc
    --dev /dev
    --ro-bind / /
    --bind /tmp /tmp
    --bind "$PROJECT_DIR" "$PROJECT_DIR"
    --chdir "$PROJECT_DIR"
  )

  # Allow writes in safe agent working dirs
  for dir in "${HOME}/.codex" "${HOME}/.gemini" "${HOME}/.claude"; do
    [ -d "$dir" ] || mkdir -p "$dir" 2>/dev/null || true
    if [ -d "$dir" ]; then
      bwrap_args+=(--bind "$dir" "$dir")
    fi
  done

  # Allow writes in user-specified allowed dirs
  for dir in "${RESOLVED_ALLOWED_DIRS[@]}"; do
    bwrap_args+=(--bind "$dir" "$dir")
  done

  # Avoid reading credentials
  if [ -d "${HOME}/.ssh" ]; then
    bwrap_args+=(--tmpfs "${HOME}/.ssh")
  fi

  exec bwrap "${bwrap_args[@]}" -- "$@"
}

OS="$(uname -s)"
case "${OS}" in
  Darwin)
    run_darwin "$@"
    ;;
  Linux)
    run_linux "$@"
    ;;
  *)
    echo "Error: Unsupported operating system '${OS}'" >&2
    exit 1
    ;;
esac